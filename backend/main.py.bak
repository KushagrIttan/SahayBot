import os
from fastapi import FastAPI, UploadFile, File
from fastapi.responses import JSONResponse
from langchain_community.llms import Ollama
from langchain_community.embeddings import SentenceTransformerEmbeddings
from langchain_community.vectorstores import Chroma
from langchain_classic.chains import RetrievalQA
from langchain_core.prompts import PromptTemplate
from langchain_community.document_loaders import PyPDFLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter
from typing import List

app = FastAPI()

CHROMA_PATH = "./chroma_db"
LLM_MODEL_NAME = "llama3.2:3b"
EMBEDDING_MODEL_NAME = "paraphrase-multilingual-MiniLM-L12-v2"

# Initialize LLM and Embeddings
llm = Ollama(model=LLM_MODEL_NAME)
embeddings = SentenceTransformerEmbeddings(model_name=EMBEDDING_MODEL_NAME)

# Load the vector store
def get_vector_store():
    if not os.path.exists(CHROMA_PATH):
        # This should ideally be handled by an ingestion step prior to starting the API
        # For now, we'll return None or raise an error if the DB doesn't exist
        print(f"Vector store not found at {CHROMA_PATH}. Please run ingestion first.")
        return None
    return Chroma(persist_directory=CHROMA_PATH, embedding_function=embeddings)


# RAG Prompt Template (English and Hindi)
# The LLM will handle the translation based on the user's input language
# and the context provided by the retriever.

PROMPT_TEMPLATE = """
Answer the question based only on the following context, in the language of the question:
{context}

Question: {question}
Answer in the language of the question:
"""

@app.post("/ingest_pdfs/")
async def ingest_pdfs(files: List[UploadFile] = File(...)):
    if not os.path.exists("../data"):
        os.makedirs("../data")

    for file in files:
        file_path = os.path.join("../data", file.filename)
        with open(file_path, "wb") as f:
            f.write(await file.read())

    # Re-ingest all documents (including new ones) into ChromaDB
    documents = []
    for filename in os.listdir("../data"):
        if filename.endswith(".pdf"):
            file_path = os.path.join("../data", filename)
            loader = PyPDFLoader(file_path)
            documents.extend(loader.load())

    text_splitter = RecursiveCharacterTextSplitter(
        chunk_size=1000,
        chunk_overlap=200,
        length_function=len,
        is_separator_regex=False,
    )
    chunks = text_splitter.split_documents(documents)

    print(f"Loaded {len(documents)} documents and created {len(chunks)} chunks for ingestion.")

    # Clear and recreate the vector store with new documents
    if os.path.exists(CHROMA_PATH):
        import shutil
        shutil.rmtree(CHROMA_PATH)
    
    db = Chroma.from_documents(
        documents=chunks,
        embedding=embeddings,
        persist_directory=CHROMA_PATH
    )
    db.persist()

    return JSONResponse(content={
        "message": f"Successfully ingested {len(files)} PDFs. Vector store updated."
    })


@app.get("/query/")
async def query_bot(question: str):
    vector_store = get_vector_store()
    if not vector_store:
        return JSONResponse(content={
            "answer": "Vector store not available. Please ingest documents first."
        }, status_code=500)

    retriever = vector_store.as_retriever()
    prompt = PromptTemplate(
        template=PROMPT_TEMPLATE,
        input_variables=["context", "question"]
    )

    qa_chain = RetrievalQA.from_chain_type(
        llm=llm,
        retriever=retriever,
        return_source_documents=True,
        chain_type_kwargs={"prompt": prompt}
    )

    result = qa_chain.invoke({"query": question})
    answer = result["result"]
    sources = [doc.metadata.get("source") for doc in result.get("source_documents", [])]

    return JSONResponse(content={
        "answer": answer,
        "sources": list(set(sources))
    })


